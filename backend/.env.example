# Any OpenAI-compatible chat endpoint works: Hugging Face router, Together, Groq, vLLM, Ollama, llama.cpp server...
MODEL_PROVIDER=openai_compatible
MODEL_BASE_URL=https://router.huggingface.co/v1
MODEL_NAME=Qwen/Qwen2.5-7B-Instruct
MODEL_CHOICES=Qwen/Qwen2.5-7B-Instruct
MODEL_API_KEY=
MAX_NEW_TOKENS=1024
TEMPERATURE=0.7
ALLOWED_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MINUTE=30
# SYSTEM_PROMPT=   (optional override of the default 17AI prompt)
